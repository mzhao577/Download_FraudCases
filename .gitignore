# --------------------------------------------------------------------------
# Downloaded corpus and caches - regenerate with the scripts, never commit.
# GitHub caps a single file at 100 MB; these are 6.2 GB together.
#   downloaded/  4.7 GB  rebuild: python discover.py && python download.py
#   state/       1.5 GB  manifest + cached API responses and page HTML
# NOTE: .gitignore does not support trailing comments on a pattern line -
# anything after the pattern becomes part of the pattern and silently matches
# nothing. Keep comments on their own lines.
# --------------------------------------------------------------------------
downloaded/
state/
logs/

# The per-year corpus folders and the test set, listed explicitly. `downloaded/`
# above already covers all of these - these lines are documentation of what is
# in there, not additional rules.
downloaded/2021/
downloaded/2022/
downloaded/2023/
downloaded/2024/
downloaded/2025/
downloaded/2026/
downloaded/testdata_DOJ_2026/

# Per-document extraction caches (rebuilt on re-run; the results are kept)
extracted/**/.cache/
extracted/.cache/

# Staging areas for corpus_push.sh / corpus_pull.sh. These hold multi-GB split
# archive parts - a single part is ~1.9 GB, far over GitHub's 100 MB file cap,
# so staging one would make the push fail and leave the object in history.
.corpus_upload/
.corpus_download/

# --------------------------------------------------------------------------
# Python
# --------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.ipynb_checkpoints/

# --------------------------------------------------------------------------
# Local tooling and OS cruft
# --------------------------------------------------------------------------
.DS_Store
.claude/
chrome-prof/
cp[0-9]*/

# Web tool input folder (symlinks + a copied CSV, rebuilt by setup_input.py)
downloaded/webtools/

# Office lock files, created while a workbook/deck is open
~$*

# Editor swap/backup files
*.swp
*.swo
*~
.*.sw?

# v2 pipeline artefacts (regenerate with the three steps)
designFeatures_v2/.cache/

# Case PDFs staged for the Hugging Face Space - 227 MB of copies of
# downloaded/DOJ_2025, rebuilt by `python hfspace_webtool2/build.py --pdfs`.
# The corpus itself is shipped as a Release asset, not in git history.
hfspace_webtool2/pdf/

# streamlit_app/pdf/ is deliberately NOT ignored: Streamlit Community Cloud
# deploys only what is committed, so the 679 case PDFs (226 MB) are tracked
# there to make the PDF pane work. That is the one copy of the corpus in git
# history - hfspace_webtool2/pdf/ above stays ignored, and the full 4.7 GB
# corpus still travels as a Release asset.
